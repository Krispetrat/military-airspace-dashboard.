{
  "name": "military-airspace-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "predeploy": "vite build",
    "deploy": "gh-pages -d dist",
    "build:web": "cross-env BUILD_TARGET=desktop vite build",
    "electron": "electron .",
    "test": "node --test electron/faa.test.cjs src/app/utils/schedule.test.ts src/app/utils/faaState.test.ts",
    "faa:probe": "node electron/faa-probe.cjs",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win portable --x64",
    "dist:win:installer": "npm run build:web && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tailwindcss/vite": "4.1.12",
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "4.7.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cross-env": "^10.1.0",
    "d3-geo": "^3.1.1",
    "date-fns": "3.6.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "8.6.0",
    "gh-pages": "^6.3.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-slick": "0.31.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tailwindcss": "4.1.12",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "1.3.8",
    "typescript": "^7.0.2",
    "us-atlas": "^3.0.1",
    "vaul": "1.1.2",
    "vite": "6.3.5",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "productName": "Military Airspace Scheduler",
  "description": "Live military airspace (MOA/ATCAA) schedule dashboard for Central Texas",
  "author": "Military Airspace Dashboard",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.airspace.scheduler",
    "productName": "Military Airspace Scheduler",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/*.test.cjs",
      "!electron/dev-harness.cjs",
      "!electron/faa-probe.cjs",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MilitaryAirspaceScheduler-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "MilitaryAirspaceScheduler-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MilitaryAirspaceScheduler-Setup-${version}.${ext}"
    }
  }
}
